[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = DipperUsbLog
  FILE_GUID                      = 95D8187C-C86F-47F6-8D59-6F9165CD1402
  MODULE_TYPE                    = UEFI_APPLICATION
