+#if XNU_QCOM_USB_DEBUG
+static bool qcom_usb_debug_kprintf_requested;
+
+static void
+qcom_usb_debug_kprintf_putc(char c)
+{
+	if (!qcom_usb_debug_is_active()) {
+		if (PE_kputc) {
+			PE_kputc(c);
+		}
+		return;
+	}
+	/* console_write_unbuffered is already teed. Avoid a second USB copy. */
+	if (PE_kputc != console_write_unbuffered) {
+		qcom_usb_debug_putc(c);
+	}
+	if (PE_kputc && PE_kputc != qcom_usb_debug_putc) {
+		PE_kputc(c);
+	}
+}
+
+#define QCOM_USB_DEBUG_KPRINTF_PUTC qcom_usb_debug_kprintf_putc
+#else
+#define QCOM_USB_DEBUG_KPRINTF_PUTC PE_kputc
+#endif
