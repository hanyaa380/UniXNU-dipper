index e459195..f0b676c 100644
--- a/osfmk/kern/sched_clutch.c
+++ b/osfmk/kern/sched_clutch.c
@@ -3164,9 +3164,11 @@ sched_clutch_thread_update_scan(sched_update_scan_context_t scan_context)
 
 extern int sched_allow_rt_smt;
 
+extern uint64_t sched_pcpu_stats[4];
+
 /* Return true if this thread should not continue running on this processor */
 static bool
-sched_clutch_thread_avoid_processor(processor_t processor, thread_t thread, __unused ast_t reason)
+sched_clutch_thread_avoid_processor(processor_t processor, thread_t thread, ast_t reason)
 {
 	if (processor->processor_primary != processor) {
 		/*
@@ -3178,6 +3180,20 @@ sched_clutch_thread_avoid_processor(processor_t processor, thread_t thread, __un
 		}
 	}
 
+	/*
+	 * fajita (pcpu=<mask>, see pset_init): as sched_edge_thread_avoid_processor() does with CLPC's rotation
+	 * bitmasks, at quantum expiry an unbound timeshare thread leaves a CPU of the migration bitmask while a
+	 * recommended CPU outside it is idle; choose_processor() then places it there. The bitmask is 0 by default.
+	 */
+	if ((reason & AST_QUANTUM) && thread->sched_pri < BASEPRI_RTQUEUES && thread->bound_processor == PROCESSOR_NULL) {
+		processor_set_t pset = processor->processor_set;
+		if (bit_test(pset->perfcontrol_cpu_migration_bitmask, processor->cpu_id) &&
+		    (pset->cpu_state_map[PROCESSOR_IDLE] & pset->recommended_bitmask & ~pset->perfcontrol_cpu_migration_bitmask) != 0) {
+			os_atomic_inc(&sched_pcpu_stats[3], relaxed);
+			return true;
+		}
+	}
+
 	return false;
 }
 
diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
