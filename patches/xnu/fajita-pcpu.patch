+extern uint64_t sched_pcpu_mask, sched_rcpu_mask, sched_pcpu_stats[4];
+extern char sched_pcpu_rows[2][240];
+TUNABLE(uint64_t, sched_pcpu_mask, "pcpu", 0);
+TUNABLE(uint64_t, sched_rcpu_mask, "rcpu", 0);
+/* [0] idle CPUs picked in the mask [1] idle CPUs picked outside it [2] idle hints passed over [3] quantum avoid decisions */
+uint64_t sched_pcpu_stats[4];
+
