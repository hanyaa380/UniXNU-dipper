--- a/bsd/vfs/vfs_lookup.c
+++ b/bsd/vfs/vfs_lookup.c
@@ -1539,7 +1539,16 @@
 	nd.ni_dvp = dvp->v_mount->mnt_vnodecovered;
 	error = namei(&nd);
 	if (error == 0) {
-		*new_dvp = nd.ni_vp;
+		/*
+		 * Only a directory below can hold the name: the base system keeps a symlink where the
