+// 48 panel pixels of 3048 x 2032 (the sweet reference uses 48 px), in the driver's normalised IOFixed coordinates. A board with
+// another panel names it: native-touch-panel-w/-h (pixels) and native-touch-edge-px (fajita: 1080, 2340 and about 64 for the
+// same ~4 mm at 402 ppi). Set once in NativeHidInput::start, before the event driver is wrapped.
+static int32_t kEdgeX=48*65536/3048,kEdgeY=48*65536/2032;
+static void configureEdges() {
+    unsigned w=3048,h=2032,px=48;
+    PE_parse_boot_argn("native-touch-panel-w",&w,sizeof(w));
+    PE_parse_boot_argn("native-touch-panel-h",&h,sizeof(h));
+    PE_parse_boot_argn("native-touch-edge-px",&px,sizeof(px));
+    if(w<64 || w>16384)w=3048;if(h<64 || h>16384)h=2032;if(px<1 || px>w/4 || px>h/4)px=48;
+    kEdgeX=(int32_t)(px*65536u/w);kEdgeY=(int32_t)(px*65536u/h);
+}
